-/// List job statuses for jobs that are associated with the user's session.
+/// List job statuses for jobs that belong to the caller.
 ///
-/// The user must be logged in. This endpoint will only show the last 36 hours
-/// of jobs. Any jobs "dismissed" by the user will not be returned.
+/// Accepts the website session cookie, an anonymous visitor cookie when no
+/// `Authorization` header is present, or an ArtCraft API key. A present
+/// `Authorization` header is only tried as an API key. This endpoint returns
+/// the last 36 hours of jobs. Jobs the user dismissed are left out.
 ///
 /// This returns jobs of all states: pending, started, attempt_failed,
 /// complete_success, dead, etc.
@@ -60,8 +64,19 @@ pub async fn list_session_jobs_handler(
 
   let mut mysql_connection = server_state.mysql_pool.acquire().await?;
 
-  let maybe_avt_token = server_state.avt_cookie_manager
-      .get_avt_token_from_request(&http_request);
+  // An Authorization header is an API key. Do not fall through to the cookie or the
+  // anonymous visitor token: a bad key must stay a 401.
+  let api_user = if http_request.headers().contains_key(header::AUTHORIZATION) {
+    Some(require_api_key_user(&http_request, &mut mysql_connection).await?)
+  } else {
+    None
+  };
+
+  let maybe_avt_token = if api_user.is_some() {
+    None
+  } else {
+    server_state.avt_cookie_manager.get_avt_token_from_request(&http_request)
+  };
 
   // ==================== USER SESSION ==================== //
 
@@ -69,10 +84,16 @@ pub async fn list_session_jobs_handler(
   //     and DB / cache errors to 500.
   // NB: The plain (non-extended) lookup is Redis-cached with a short TTL, which matters here:
   //     this is the hottest polling endpoint in the app, and it only needs the user token.
-  let maybe_user_session = server_state
-      .session_checker
-      .maybe_get_user_session_from_connection(&http_request, &mut mysql_connection)
-      .await?;
+  let maybe_user_session = if api_user.is_some() {
+    None
+  } else {
+    server_state
+        .session_checker
+        .maybe_get_user_session_from_connection(&http_request, &mut mysql_connection)
+        .await?
+  };
+
+  let api_user_token = api_user.as_ref().map(|user| &user.user_token);
 
   let include_states = query.include_states
       .as_deref()
@@ -86,12 +107,16 @@ pub async fn list_session_jobs_handler(
           .filter_map(|status| JobStatusPlus::from_str(status).ok())
           .collect::<HashSet<_>>());
 
-  let user = match (maybe_user_session.as_ref(), maybe_avt_token.as_ref()) {
-    (Some(session), _) => SessionUser::User(&session.user_token),
-    (None, Some(avt_token)) => SessionUser::Anonymous(avt_token),
-    (None, None) => {
-      // TODO(bt,2025-04-15): We should install an AVT cookie.
-      return Err(CommonWebError::NotAuthorized);
+  let user = if let Some(user_token) = api_user_token {
+    SessionUser::User(user_token)
+  } else {
+    match (maybe_user_session.as_ref(), maybe_avt_token.as_ref()) {
+      (Some(session), _) => SessionUser::User(&session.user_token),
+      (None, Some(avt_token)) => SessionUser::Anonymous(avt_token),
+      (None, None) => {
+        // TODO(bt,2025-04-15): We should install an AVT cookie.
+        return Err(CommonWebError::NotAuthorized);
+      }
     }
   };
 
