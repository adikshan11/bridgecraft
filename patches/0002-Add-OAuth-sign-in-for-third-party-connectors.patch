+pub async fn oauth_revoke_grant(
+  request: HttpRequest,
+  path: actix_web::web::Path<String>,
+  server_state: Data<Arc<ServerState>>,
+) -> HttpResponse {
+  if let Some(origin) = request.headers().get(header::ORIGIN).and_then(|value| value.to_str().ok()) {
+    let host = request.connection_info().host().to_string();
+    if !origin_matches_host(origin, &host) {
+      return oauth_error(400, "invalid_request", "revoke came from another site");
+    }
+  }
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth grant revoke pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not revoke the app");
+    }
+  };
+  let user = match require_user_session(&request, &server_state.session_checker, &mut *connection).await {
+    Ok(user) => user,
+    Err(CommonWebError::NotAuthorized) => {
+      return html_page("Sign in to ArtCraft", "<p>Sign in to ArtCraft in this browser, then try again.</p>");
+    }
+    Err(err) => {
+      warn!("OAuth grant revoke session error: {:?}", err);
+      return oauth_error(500, "server_error", "could not revoke the app");
+    }
+  };
+  let client_token = path.into_inner();
+  if let Err(err) = revoke_oauth_grants_for_client(user.get_user_token().as_str(), &client_token, &mut *connection).await {
+    warn!("OAuth grant revoke error: {:?}", err);
+    return oauth_error(500, "server_error", "could not revoke the app");
+  }
+  HttpResponse::Found().append_header((header::LOCATION, "/oauth/grants")).finish()
+}
+
+async fn authorization_code_grant(
+  client: &mysql_queries::queries::oauth::OauthClientRecord,
+  fields: &HashMap<String, String>,
+  connection: &mut sqlx::MySqlConnection,
+) -> HttpResponse {
+  let Some(code) = fields.get("code") else {
+    return oauth_error(400, "invalid_request", "code is required");
+  };
+  let Some(redirect_uri) = fields.get("redirect_uri") else {
+    return oauth_error(400, "invalid_request", "redirect_uri is required");
+  };
+  let Some(verifier) = fields.get("code_verifier") else {
+    return oauth_error(400, "invalid_request", "code_verifier is required");
+  };
+  if !pkce_verifier_ok(verifier) {
+    return oauth_error(400, "invalid_grant", "code_verifier is not valid");
+  }
+  let mut tx = match connection.begin().await {
+    Ok(tx) => tx,
+    Err(err) => {
+      warn!("OAuth code transaction error: {:?}", err);
+      return oauth_error(500, "server_error", "could not issue a token");
+    }
+  };
+  let code_hash = sha256_hex(code);
+  let record = match lock_oauth_authorization_code(&code_hash, &mut *tx).await {
+    Ok(Some(record)) => record,
+    Ok(None) => return oauth_error(400, "invalid_grant", "code is expired or already used"),
+    Err(err) => {
+      warn!("OAuth code lock error: {:?}", err);
+      return oauth_error(500, "server_error", "could not issue a token");
+    }
+  };
+  let challenge = pkce_s256_challenge(verifier);
+  let matches = record.client_token == client.token
+    && record.redirect_uri == *redirect_uri
+    && record.code_challenge == challenge
+    && record.code_challenge_method == "S256";
+  if let Err(err) = mark_oauth_authorization_code_used(&code_hash, &mut *tx).await {
+    warn!("OAuth code consume error: {:?}", err);
+    return oauth_error(500, "server_error", "could not issue a token");
+  }
+  if !matches {
+    let _ = tx.commit().await;
+    return oauth_error(400, "invalid_grant", "code does not match this client");
+  }
+  match mint_token_pair(&record.user_token, &client.token, &record.scopes, &mut tx).await {
+    Ok(response) => {
+      if let Err(err) = tx.commit().await {
+        warn!("OAuth code commit error: {:?}", err);
+        return oauth_error(500, "server_error", "could not issue a token");
+      }
+      response
+    }
+    Err(response) => response,
+  }
+}
+
+async fn refresh_grant(
+  client: &mysql_queries::queries::oauth::OauthClientRecord,
+  fields: &HashMap<String, String>,
+  connection: &mut sqlx::MySqlConnection,
+) -> HttpResponse {
+  let Some(refresh_token) = fields.get("refresh_token") else {
+    return oauth_error(400, "invalid_request", "refresh_token is required");
+  };
+  if !refresh_token.starts_with(REFRESH_TOKEN_PREFIX) {
+    return oauth_error(400, "invalid_grant", "refresh token was not recognized");
+  }
+  let mut tx = match connection.begin().await {
+    Ok(tx) => tx,
+    Err(err) => {
+      warn!("OAuth refresh transaction error: {:?}", err);
+      return oauth_error(500, "server_error", "could not refresh the token");
+    }
+  };
+  let hash = sha256_hex(refresh_token);
+  let locked = match lock_oauth_refresh_session(&hash, &mut *tx).await {
+    Ok(Some(locked)) => locked,
+    Ok(None) => return oauth_error(400, "invalid_grant", "refresh token is expired or revoked"),
+    Err(err) => {
+      warn!("OAuth refresh lock error: {:?}", err);
+      return oauth_error(500, "server_error", "could not refresh the token");
+    }
+  };
+  if locked.session.client_token != client.token {
+    return oauth_error(400, "invalid_grant", "refresh token belongs to another client");
+  }
+  if locked.session.record.is_banned {
+    return oauth_error(400, "invalid_grant", "this account cannot sign in");
+  }
+  if let Err(err) = revoke_oauth_refresh_hash(&hash, &mut *tx).await {
+    warn!("OAuth refresh revoke error: {:?}", err);
+    return oauth_error(500, "server_error", "could not refresh the token");
+  }
+  let scopes = locked.session.scopes.clone();
+  let user_token = locked.session.record.user_token.as_str().to_string();
+  match mint_token_pair(&user_token, &client.token, &scopes, &mut tx).await {
+    Ok(response) => {
+      if let Err(err) = tx.commit().await {
+        warn!("OAuth refresh commit error: {:?}", err);
+        return oauth_error(500, "server_error", "could not refresh the token");
+      }
+      response
+    }
+    Err(response) => response,
+  }
+}
+
+async fn mint_token_pair<'c, E>(
+  user_token: &str,
+  client_token: &str,
+  scopes: &str,
+  mysql_executor: E,
+) -> Result<HttpResponse, HttpResponse>
+where
+  E: sqlx::Executor<'c, Database = sqlx::MySql>,
+{
+  let access_token = random_token(ACCESS_TOKEN_PREFIX, 43);
+  let refresh_token = random_token(REFRESH_TOKEN_PREFIX, 43);
+  if let Err(err) = insert_oauth_access_token(
+    InsertOauthAccessTokenArgs {
+      access_token_hash: &sha256_hex(&access_token),
+      refresh_token_hash: &sha256_hex(&refresh_token),
+      client_token,
+      user_token,
+      scopes,
+      access_ttl_seconds: ACCESS_TOKEN_TTL_SECONDS as i64,
+      refresh_ttl_seconds: REFRESH_TOKEN_TTL_SECONDS as i64,
+    },
+    mysql_executor,
+  ).await {
+    warn!("OAuth token insert error: {:?}", err);
+    return Err(oauth_error(500, "server_error", "could not issue a token"));
+  }
+  Ok(HttpResponse::Ok().json(serde_json::json!({
+    "access_token": access_token,
+    "token_type": "Bearer",
+    "expires_in": ACCESS_TOKEN_TTL_SECONDS,
+    "refresh_token": refresh_token,
+    "scope": scopes,
+  })))
+}
+
+async fn load_client(
+  client_id: &str,
+  connection: &mut sqlx::MySqlConnection,
+) -> Result<mysql_queries::queries::oauth::OauthClientRecord, HttpResponse> {
+  match get_oauth_client_by_token(client_id, &mut *connection).await {
+    Ok(Some(client)) => Ok(client),
+    Ok(None) => Err(oauth_error(401, "invalid_client", "unknown client")),
+    Err(err) => {
+      warn!("OAuth client lookup error: {:?}", err);
+      Err(oauth_error(500, "server_error", "could not read the client"))
+    }
+  }
+}
+
+async fn authenticate_client(
+  request: &HttpRequest,
+  fields: &HashMap<String, String>,
+  connection: &mut sqlx::MySqlConnection,
+) -> Result<mysql_queries::queries::oauth::OauthClientRecord, HttpResponse> {
+  let basic = request.headers().get(header::AUTHORIZATION).and_then(|value| value.to_str().ok()).and_then(parse_basic_client);
+  let (client_id, presented_secret) = if let Some((id, secret)) = basic {
+    (id, Some(secret))
+  } else {
+    let Some(id) = fields.get("client_id").cloned() else {
+      return Err(oauth_error(401, "invalid_client", "client_id is required"));
+    };
+    (id, fields.get("client_secret").cloned())
+  };
+  let client = load_client(&client_id, connection).await?;
+  match client.token_endpoint_auth_method.as_str() {
+    "none" => {
+      if presented_secret.is_some() {
+        return Err(oauth_error(401, "invalid_client", "this client has no secret"));
+      }
+    }
+    "client_secret_basic" | "client_secret_post" => {
+      let Some(secret) = presented_secret else {
+        return Err(oauth_error(401, "invalid_client", "client_secret is required"));
+      };
+      let Some(hash) = client.client_secret_hash.as_deref() else {
+        return Err(oauth_error(401, "invalid_client", "this client has no secret"));
+      };
+      if !secrets_match(&secret, hash) {
+        return Err(oauth_error(401, "invalid_client", "client_secret was not accepted"));
+      }
+    }
+    _ => return Err(oauth_error(401, "invalid_client", "unsupported client authentication")),
+  }
+  Ok(client)
+}
+
+fn form_or_json(request: &HttpRequest, body: &Bytes) -> Result<HashMap<String, String>, HttpResponse> {
+  let content_type = request
+    .headers()
+    .get(header::CONTENT_TYPE)
+    .and_then(|value| value.to_str().ok())
+    .unwrap_or("");
+  if content_type.starts_with("application/json") {
+    let value: serde_json::Value = serde_json::from_slice(body)
+      .map_err(|_| oauth_error(400, "invalid_request", "body is not JSON"))?;
+    let Some(object) = value.as_object() else {
+      return Err(oauth_error(400, "invalid_request", "body is not a JSON object"));
+    };
+    let mut fields = HashMap::new();
+    for (key, item) in object {
+      if let Some(text) = item.as_str() {
+        fields.insert(key.clone(), text.to_string());
+      }
+    }
+    return Ok(fields);
+  }
+  let text = std::str::from_utf8(body).map_err(|_| oauth_error(400, "invalid_request", "body is not text"))?;
+  Ok(parse_form(text))
+}
+
+fn parse_form(body: &str) -> HashMap<String, String> {
+  let mut fields = HashMap::new();
+  for pair in body.split('&') {
+    if pair.is_empty() {
+      continue;
+    }
+    let (key, value) = pair.split_once('=').unwrap_or((pair, ""));
+    fields.insert(percent_decode(key), percent_decode(value));
+  }
+  fields
+}
+
+fn percent_decode(value: &str) -> String {
+  let value = value.replace('+', " ");
+  let bytes = value.as_bytes();
+  let mut out = Vec::new();
+  let mut i = 0;
+  while i < bytes.len() {
+    if bytes[i] == b'%' && i + 2 < bytes.len() {
+      if let Ok(byte) = u8::from_str_radix(&value[i + 1..i + 3], 16) {
+        out.push(byte);
+        i += 3;
+        continue;
+      }
+    }
+    out.push(bytes[i]);
+    i += 1;
+  }
+  String::from_utf8_lossy(&out).into_owned()
+}
+
+fn percent_encode(value: &str) -> String {
+  let mut out = String::new();
+  for byte in value.bytes() {
+    if byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.' | b'_' | b'~') {
+      out.push(byte as char);
+    } else {
+      out.push_str(&format!("%{byte:02X}"));
+    }
+  }
+  out
+}
+
+fn oauth_error(status: u16, error: &str, description: &str) -> HttpResponse {
+  let code = actix_web::http::StatusCode::from_u16(status).unwrap_or(actix_web::http::StatusCode::BAD_REQUEST);
+  HttpResponse::build(code).json(serde_json::json!({
+    "error": error,
+    "error_description": description,
+  }))
+}
+
+fn redirect_error(redirect_uri: &str, error: &str, state: Option<&str>) -> HttpResponse {
+  let mut location = format!(
+    "{redirect_uri}{}error={}",
+    if redirect_uri.contains('?') { '&' } else { '?' },
+    percent_encode(error),
+  );
+  if let Some(state) = state {
+    if !state.is_empty() {
+      location.push_str("&state=");
+      location.push_str(&percent_encode(state));
+    }
+  }
+  HttpResponse::Found().append_header((header::LOCATION, location)).finish()
+}
+
+fn html_page(title: &str, body: &str) -> HttpResponse {
+  let title = html_escape(title);
+  HttpResponse::Ok()
+    .content_type("text/html; charset=utf-8")
+    .body(format!(
+      "<!doctype html><html><head><meta charset=\"utf-8\"><title>{title}</title></head><body><h1>{title}</h1>{body}</body></html>"
+    ))
+}
+
+fn scope_line(scope: &str) -> String {
+  let text = match scope {
+    "generate" => "Spend your credits on generation.",
+    "library:read" => "Read your projects, meshes, splats, and jobs.",
+    "library:write" => "Upload files to your library.",
+    _ => "Use your account.",
+  };
+  format!("<li>{}</li>", html_escape(text))
+}
+
+fn external_origin(request: &HttpRequest) -> String {
+  let info = request.connection_info();
+  format!("{}://{}", info.scheme(), info.host())
+}
