+pub async fn oauth_authorize_post(
+  request: HttpRequest,
+  form: Form<AuthorizeForm>,
+  server_state: Data<Arc<ServerState>>,
+) -> HttpResponse {
+  if let Some(origin) = request.headers().get(header::ORIGIN).and_then(|value| value.to_str().ok()) {
+    let host = request.connection_info().host().to_string();
+    if !origin_matches_host(origin, &host) {
+      return oauth_error(400, "invalid_request", "consent came from another site");
+    }
+  }
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth consent pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not finish authorization");
+    }
+  };
+  let user = match require_user_session(&request, &server_state.session_checker, &mut *connection).await {
+    Ok(user) => user,
+    Err(CommonWebError::NotAuthorized) => {
+      return html_page("Sign in to ArtCraft", "<p>Sign in to ArtCraft in this browser, then try again.</p>");
+    }
+    Err(err) => {
+      warn!("OAuth consent session error: {:?}", err);
+      return oauth_error(500, "server_error", "could not read the session");
+    }
+  };
+  let client = match load_client(&form.client_id, &mut *connection).await {
+    Ok(client) => client,
+    Err(response) => return response,
+  };
+  if !redirect_matches(&client.redirect_uris, &form.redirect_uri) {
+    return html_page("Sign-in stopped", "<p>That redirect address is not registered for this app.</p>");
+  }
+  if form.decision != "approve" {
+    return redirect_error(&form.redirect_uri, "access_denied", Some(&form.state));
+  }
+  let scopes = match normalize_scopes(&form.scope) {
+    Ok(scopes) if scopes_within(&scopes, &client.allowed_scopes) => scopes,
+    _ => return redirect_error(&form.redirect_uri, "invalid_scope", Some(&form.state)),
+  };
+  if form.code_challenge_method != "S256" || !code_challenge_ok(&form.code_challenge) {
+    return redirect_error(&form.redirect_uri, "invalid_request", Some(&form.state));
+  }
+
+  let code = random_token(AUTH_CODE_PREFIX, 43);
+  let code_hash = sha256_hex(&code);
+  if let Err(err) = insert_oauth_authorization_code(
+    InsertOauthAuthorizationCodeArgs {
+      code_hash: &code_hash,
+      client_token: &client.token,
+      user_token: user.get_user_token().as_str(),
+      redirect_uri: &form.redirect_uri,
+      scopes: &scopes,
+      code_challenge: &form.code_challenge,
+      code_challenge_method: "S256",
+      ttl_seconds: AUTH_CODE_TTL_SECONDS as i64,
+    },
+    &mut *connection,
+  ).await {
+    warn!("OAuth code insert error: {:?}", err);
+    return oauth_error(500, "server_error", "could not finish authorization");
+  }
+  let location = format!(
+    "{}{}code={}&state={}",
+    form.redirect_uri,
+    if form.redirect_uri.contains('?') { '&' } else { '?' },
+    percent_encode(&code),
+    percent_encode(&form.state),
+  );
+  HttpResponse::Found().append_header((header::LOCATION, location)).finish()
+}
+
+pub async fn oauth_token(
+  request: HttpRequest,
+  body: Bytes,
+  server_state: Data<Arc<ServerState>>,
+) -> HttpResponse {
+  let fields = match form_or_json(&request, &body) {
+    Ok(fields) => fields,
+    Err(response) => return response,
+  };
+  let grant = fields.get("grant_type").map(String::as_str).unwrap_or("");
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth token pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not issue a token");
+    }
+  };
+  let client = match authenticate_client(&request, &fields, &mut *connection).await {
+    Ok(client) => client,
+    Err(response) => return response,
+  };
+  match grant {
+    "authorization_code" => authorization_code_grant(&client, &fields, &mut *connection).await,
+    "refresh_token" => refresh_grant(&client, &fields, &mut *connection).await,
+    _ => oauth_error(400, "unsupported_grant_type", "use authorization_code or refresh_token"),
+  }
+}
+
+pub async fn oauth_revoke(request: HttpRequest, body: Bytes, server_state: Data<Arc<ServerState>>) -> HttpResponse {
+  let fields = match form_or_json(&request, &body) {
+    Ok(fields) => fields,
+    Err(response) => return response,
+  };
+  let Some(token) = fields.get("token") else {
+    return HttpResponse::Ok().finish();
+  };
+  // Refuse to treat an access-token-shaped string as something else, but still
+  // hash whatever was sent. Unknown hashes revoke nothing and still return 200.
+  if !token.is_empty() {
+    let hash = sha256_hex(token);
+    let mut connection = match server_state.mysql_pool.acquire().await {
+      Ok(connection) => connection,
+      Err(err) => {
+        warn!("OAuth revoke pool error: {:?}", err);
+        return oauth_error(500, "server_error", "could not revoke the token");
+      }
+    };
+    if let Err(err) = revoke_oauth_token_hash(&hash, &mut *connection).await {
+      warn!("OAuth revoke error: {:?}", err);
+      return oauth_error(500, "server_error", "could not revoke the token");
+    }
+  }
+  HttpResponse::Ok().finish()
+}
