+use actix_web::HttpRequest;
+use sqlx::MySqlConnection;
+
+use mysql_queries::queries::oauth::{get_oauth_access_session_by_hash, OauthAccessSession};
+use tokens::tokens::api_keys::ApiKeyToken;
+
+use crate::http_server::common_responses::common_web_error::CommonWebError;
+use crate::http_server::oauth::protocol::{access_token_from_authorization, scope_granted, sha256_hex};
+use crate::http_server::user_lookup::api_keys::require_api_key_user::{require_api_key_user, UserApiSession};
+
+pub enum OauthPresentation {
+  /// Header is missing or is not an `artcraft_oauth_at_` access token.
+  NotAnOauthToken,
+  /// Prefix matched, but the token is unknown, expired, or revoked.
+  Rejected,
+  Accepted(OauthAccessSession),
+}
+
+pub async fn present_oauth_access(
+  authorization_header: Option<&str>,
+  mysql_connection: &mut MySqlConnection,
+) -> Result<OauthPresentation, CommonWebError> {
+  let Some(token) = authorization_header.and_then(access_token_from_authorization) else {
+    return Ok(OauthPresentation::NotAnOauthToken);
+  };
+  let hash = sha256_hex(token);
+  match get_oauth_access_session_by_hash(&hash, &mut *mysql_connection).await {
+    Ok(Some(session)) => Ok(OauthPresentation::Accepted(session)),
+    Ok(None) => Ok(OauthPresentation::Rejected),
+    Err(err) => {
+      log::warn!("OAuth access token lookup error: {:?}", err);
+      Err(CommonWebError::from_error(err))
+    }
+  }
+}
+
+/// API key, or an OAuth access token that has one of `any_of` scopes.
+/// API keys are not scoped. An OAuth token without the scope is 403.
+pub async fn require_api_key_or_oauth_scope(
+  http_request: &HttpRequest,
+  mysql_connection: &mut MySqlConnection,
+  any_of: &[&str],
+) -> Result<UserApiSession, CommonWebError> {
+  let header = http_request
+    .headers()
+    .get(actix_web::http::header::AUTHORIZATION)
+    .and_then(|value| value.to_str().ok());
+  match present_oauth_access(header, mysql_connection).await? {
+    OauthPresentation::NotAnOauthToken => require_api_key_user(http_request, mysql_connection).await,
+    OauthPresentation::Rejected => Err(CommonWebError::NotAuthorized),
+    OauthPresentation::Accepted(session) => {
+      reject_unless_scope(&session, any_of)?;
+      Ok(user_api_session_from_oauth(session))
+    }
+  }
+}
+
+pub fn reject_unless_scope(session: &OauthAccessSession, any_of: &[&str]) -> Result<(), CommonWebError> {
+  if session.record.is_banned {
+    log::warn!("OAuth token owner is banned");
+    return Err(CommonWebError::NotAuthorized);
+  }
+  if any_of.iter().any(|scope| scope_granted(&session.scopes, scope)) {
+    Ok(())
+  } else {
+    log::warn!("OAuth token is missing a required scope");
+    Err(CommonWebError::Forbidden)
+  }
+}
+
+pub async fn require_library_user(
+  http_request: &HttpRequest,
+  session_checker: &crate::http_server::user_lookup::user_session::session_utils::session_checker::SessionChecker,
+  avt_cookie_manager: &actix_artcraft::sessions::anonymous_visitor_tracking::avt_cookie_manager::AvtCookieManager,
+  mysql_connection: &mut MySqlConnection,
+) -> Result<tokens::tokens::users::UserToken, CommonWebError> {
+  use crate::http_server::oauth::protocol::SCOPE_LIBRARY_READ;
+  use crate::http_server::user_lookup::api_or_web_session::require_api_or_web_session::require_api_or_web_session;
+
+  let header = http_request
+    .headers()
+    .get(actix_web::http::header::AUTHORIZATION)
+    .and_then(|value| value.to_str().ok());
+  match present_oauth_access(header, mysql_connection).await? {
+    OauthPresentation::Accepted(session) => {
+      reject_unless_scope(&session, &[SCOPE_LIBRARY_READ])?;
+      Ok(session.record.user_token)
+    }
+    OauthPresentation::Rejected => Err(CommonWebError::NotAuthorized),
+    OauthPresentation::NotAnOauthToken => {
+      let session = require_api_or_web_session(
+        http_request,
+        session_checker,
+        avt_cookie_manager,
+        &mut *mysql_connection,
+      ).await?;
+      Ok(session.user_token)
+    }
+  }
+}
+
+pub fn user_api_session_from_oauth(session: OauthAccessSession) -> UserApiSession {
+  UserApiSession {
+    // OAuth callers have no API key. Callers read `user_token`.
+    api_key_token: ApiKeyToken::new_from_str("oauth"),
+    user_token: session.record.user_token,
+    is_banned: session.record.is_banned,
+  }
+}
