+use mysql_queries::queries::oauth::{
+  get_oauth_client_by_token, insert_oauth_access_token, insert_oauth_authorization_code,
+  insert_oauth_client, list_oauth_grants_for_user, lock_oauth_authorization_code,
+  lock_oauth_refresh_session, mark_oauth_authorization_code_used, revoke_oauth_grants_for_client,
+  revoke_oauth_refresh_hash, revoke_oauth_token_hash, InsertOauthAccessTokenArgs,
+  InsertOauthAuthorizationCodeArgs, InsertOauthClientArgs,
+};
+
+use crate::http_server::common_responses::common_web_error::CommonWebError;
+use crate::http_server::oauth::protocol::{
+  code_challenge_ok, html_escape, normalize_scopes, origin_matches_host, parse_basic_client,
+  pkce_s256_challenge, pkce_verifier_ok, random_token, redirect_matches, redirect_uri_allowed,
+  scopes_within, secrets_match, sha256_hex, ACCESS_TOKEN_PREFIX, ACCESS_TOKEN_TTL_SECONDS,
+  AUTH_CODE_PREFIX, AUTH_CODE_TTL_SECONDS, CLIENT_ID_PREFIX, REFRESH_TOKEN_PREFIX,
+  REFRESH_TOKEN_TTL_SECONDS,
+};
+use crate::http_server::user_lookup::user_session::require_user_session::require_user_session;
+use crate::state::server_state::ServerState;
+
+#[derive(Deserialize)]
+struct RegisterBody {
+  client_name: String,
+  redirect_uris: Vec<String>,
+  token_endpoint_auth_method: Option<String>,
+  scope: Option<String>,
+  grant_types: Option<Vec<String>>,
+  response_types: Option<Vec<String>>,
+}
+
+#[derive(Deserialize)]
+struct AuthorizeQuery {
+  response_type: String,
+  client_id: String,
+  redirect_uri: String,
+  scope: Option<String>,
+  state: Option<String>,
+  code_challenge: Option<String>,
+  code_challenge_method: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct AuthorizeForm {
+  client_id: String,
+  redirect_uri: String,
+  scope: String,
+  state: String,
+  code_challenge: String,
+  code_challenge_method: String,
+  decision: String,
+}
+
+pub async fn oauth_discovery(request: HttpRequest) -> HttpResponse {
+  let origin = external_origin(&request);
+  HttpResponse::Ok().json(serde_json::json!({
+    "issuer": origin,
+    "authorization_endpoint": format!("{origin}/oauth/authorize"),
+    "token_endpoint": format!("{origin}/oauth/token"),
+    "registration_endpoint": format!("{origin}/oauth/register"),
+    "revocation_endpoint": format!("{origin}/oauth/revoke"),
+    "response_types_supported": ["code"],
+    "grant_types_supported": ["authorization_code", "refresh_token"],
+    "code_challenge_methods_supported": ["S256"],
+    "token_endpoint_auth_methods_supported": ["none", "client_secret_post", "client_secret_basic"],
+    "scopes_supported": ["generate", "library:read", "library:write"],
+  }))
+}
+
+pub async fn oauth_register(
+  body: Json<RegisterBody>,
+  server_state: Data<Arc<ServerState>>,
+) -> HttpResponse {
+  let method = body.token_endpoint_auth_method.as_deref().unwrap_or("none");
+  if !matches!(method, "none" | "client_secret_post" | "client_secret_basic") {
+    return oauth_error(400, "invalid_client_metadata", "unsupported token_endpoint_auth_method");
+  }
+  if let Some(grants) = &body.grant_types {
+    if grants.iter().any(|grant| grant != "authorization_code" && grant != "refresh_token") {
+      return oauth_error(400, "invalid_client_metadata", "unsupported grant_type");
+    }
+  }
+  if let Some(responses) = &body.response_types {
+    if responses.iter().any(|response| response != "code") {
+      return oauth_error(400, "invalid_client_metadata", "unsupported response_type");
+    }
+  }
+  let name = body.client_name.trim();
+  if name.is_empty() || name.len() > 255 {
+    return oauth_error(400, "invalid_client_metadata", "client_name is required");
+  }
+  if body.redirect_uris.is_empty() || body.redirect_uris.len() > 10 {
+    return oauth_error(400, "invalid_redirect_uri", "provide 1 to 10 redirect URIs");
+  }
+  if body.redirect_uris.iter().any(|uri| !redirect_uri_allowed(uri)) {
+    return oauth_error(400, "invalid_redirect_uri", "redirect URIs must be https, or http on localhost");
+  }
+  let scopes = match normalize_scopes(body.scope.as_deref().unwrap_or("generate library:read library:write")) {
+    Ok(scopes) => scopes,
+    Err(_) => return oauth_error(400, "invalid_client_metadata", "unknown scope"),
+  };
+
+  let client_id = random_token(CLIENT_ID_PREFIX, 26);
+  let (client_secret, client_secret_hash) = if method == "none" {
+    (None, None)
+  } else {
+    let secret = random_token("artcraft_oauth_cs_", 43);
+    let hash = sha256_hex(&secret);
+    (Some(secret), Some(hash))
+  };
+  let redirect_uris = body.redirect_uris.join("\n");
+
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth register pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not store the client");
+    }
+  };
+  if let Err(err) = insert_oauth_client(
+    InsertOauthClientArgs {
+      token: &client_id,
+      client_secret_hash: client_secret_hash.as_deref(),
+      client_name: name,
+      redirect_uris: &redirect_uris,
+      token_endpoint_auth_method: method,
+      allowed_scopes: &scopes,
+    },
+    &mut *connection,
+  ).await {
+    warn!("OAuth register insert error: {:?}", err);
+    return oauth_error(500, "server_error", "could not store the client");
+  }
+
+  let mut response = serde_json::json!({
+    "client_id": client_id,
+    "client_name": name,
+    "redirect_uris": body.redirect_uris,
+    "grant_types": ["authorization_code", "refresh_token"],
+    "response_types": ["code"],
+    "token_endpoint_auth_method": method,
+    "scope": scopes,
+  });
+  if let Some(secret) = client_secret {
+    response["client_secret"] = serde_json::Value::String(secret);
+  }
+  HttpResponse::Created().json(response)
+}
+
+pub async fn oauth_authorize_get(
+  request: HttpRequest,
+  query: Query<AuthorizeQuery>,
+  server_state: Data<Arc<ServerState>>,
+) -> HttpResponse {
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth authorize pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not start authorization");
+    }
+  };
+  let client = match load_client(&query.client_id, &mut *connection).await {
+    Ok(client) => client,
+    Err(response) => return response,
+  };
+  if !redirect_matches(&client.redirect_uris, &query.redirect_uri) || !redirect_uri_allowed(&query.redirect_uri) {
+    return html_page("Sign-in stopped", "<p>That redirect address is not registered for this app.</p>");
+  }
+  let state = query.state.clone().unwrap_or_default();
+  if query.response_type != "code" {
+    return redirect_error(&query.redirect_uri, "unsupported_response_type", Some(&state));
+  }
+  if state.is_empty() {
+    return redirect_error(&query.redirect_uri, "invalid_request", None);
+  }
+  let challenge = query.code_challenge.clone().unwrap_or_default();
+  let method = query.code_challenge_method.clone().unwrap_or_default();
+  if method != "S256" || !code_challenge_ok(&challenge) {
+    return redirect_error(&query.redirect_uri, "invalid_request", Some(&state));
+  }
+  let scopes = match query.scope.as_deref() {
+    Some(scope) => match normalize_scopes(scope) {
+      Ok(scopes) if scopes_within(&scopes, &client.allowed_scopes) => scopes,
+      _ => return redirect_error(&query.redirect_uri, "invalid_scope", Some(&state)),
+    },
+    None => client.allowed_scopes.clone(),
+  };
+
+  let user = match require_user_session(&request, &server_state.session_checker, &mut *connection).await {
+    Ok(user) => user,
+    Err(CommonWebError::NotAuthorized) => {
+      return html_page(
+        "Sign in to ArtCraft",
+        "<p>Sign in to ArtCraft in this browser, then reload this page to approve the app.</p>",
+      );
+    }
+    Err(err) => {
+      warn!("OAuth authorize session error: {:?}", err);
+      return oauth_error(500, "server_error", "could not read the session");
+    }
+  };
+  let _ = user;
+
+  let scope_lines = scopes.split_whitespace().map(scope_line).collect::<String>();
+  let page = format!(
+    "<p><strong>{}</strong> is asking to use your ArtCraft account.</p><ul>{}</ul>\
+     <form method=\"post\" action=\"/oauth/authorize\">\
+     <input type=\"hidden\" name=\"client_id\" value=\"{}\">\
+     <input type=\"hidden\" name=\"redirect_uri\" value=\"{}\">\
+     <input type=\"hidden\" name=\"scope\" value=\"{}\">\
+     <input type=\"hidden\" name=\"state\" value=\"{}\">\
+     <input type=\"hidden\" name=\"code_challenge\" value=\"{}\">\
+     <input type=\"hidden\" name=\"code_challenge_method\" value=\"S256\">\
+     <button type=\"submit\" name=\"decision\" value=\"approve\">Allow</button>\
+     <button type=\"submit\" name=\"decision\" value=\"deny\">Deny</button>\
+     </form>",
+    html_escape(&client.client_name),
+    scope_lines,
+    html_escape(&query.client_id),
+    html_escape(&query.redirect_uri),
+    html_escape(&scopes),
+    html_escape(&state),
+    html_escape(&challenge),
+  );
+  html_page("Allow this app", &page)
+}
