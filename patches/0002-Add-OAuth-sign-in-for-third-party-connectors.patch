+-- noinspection SqlDialectInspectionForFile
+-- noinspection SqlNoDataSourceInspectionForFile
+-- noinspection SqlResolveForFile
+
+-- OAuth 2.1 clients, authorization codes, and access tokens for third-party
+-- connectors (ChatGPT, Claude, and other MCP clients). Secrets are stored as
+-- SHA-256 hex digests. The raw secret is returned once, at creation.
+
+CREATE TABLE oauth_clients (
+  id BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
+
+  -- Public client_id. Prefix artcraft_oauth_cl_.
+  token VARCHAR(64) NOT NULL,
+
+  -- SHA-256 hex of the client secret. NULL for a public client (token_endpoint_auth_method = none).
+  client_secret_hash CHAR(64) DEFAULT NULL,
+
+  client_name VARCHAR(255) NOT NULL,
+
+  -- Exact redirect URIs, separated by newlines. No wildcards.
+  redirect_uris TEXT NOT NULL,
+
+  -- none, client_secret_post, or client_secret_basic.
+  token_endpoint_auth_method VARCHAR(32) NOT NULL,
+
+  -- Space-separated scopes this client is allowed to request.
+  allowed_scopes VARCHAR(255) NOT NULL,
+
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  maybe_revoked_at TIMESTAMP NULL,
+
+  PRIMARY KEY (id),
+  UNIQUE KEY (token),
+  KEY index_maybe_revoked_at (maybe_revoked_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
+
+CREATE TABLE oauth_authorization_codes (
+  id BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
+
+  -- SHA-256 hex of the authorization code.
+  code_hash CHAR(64) NOT NULL,
+
+  client_token VARCHAR(64) NOT NULL,
+  user_token VARCHAR(32) NOT NULL,
+  redirect_uri VARCHAR(2048) NOT NULL,
+  scopes VARCHAR(255) NOT NULL,
+  code_challenge VARCHAR(128) NOT NULL,
+  code_challenge_method VARCHAR(8) NOT NULL,
+
+  expires_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  maybe_used_at TIMESTAMP NULL,
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+  PRIMARY KEY (id),
+  UNIQUE KEY (code_hash),
+  KEY index_client_token (client_token),
+  KEY index_user_token (user_token)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
+
+CREATE TABLE oauth_access_tokens (
+  id BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
+
+  -- SHA-256 hex of the access token (prefix artcraft_oauth_at_).
+  access_token_hash CHAR(64) NOT NULL,
+
+  -- SHA-256 hex of the refresh token (prefix artcraft_oauth_rt_).
+  refresh_token_hash CHAR(64) NOT NULL,
+
+  client_token VARCHAR(64) NOT NULL,
+  user_token VARCHAR(32) NOT NULL,
+  scopes VARCHAR(255) NOT NULL,
+
+  expires_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  refresh_expires_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  maybe_revoked_at TIMESTAMP NULL,
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+  PRIMARY KEY (id),
+  UNIQUE KEY (access_token_hash),
+  UNIQUE KEY (refresh_token_hash),
+  KEY index_user_token (user_token),
+  KEY index_client_token (client_token),
+  KEY index_maybe_revoked_at (maybe_revoked_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
