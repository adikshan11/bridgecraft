@@ -0,0 +1,380 @@
+//! OAuth 2.1 helpers for the ArtCraft connector sign-in.
+//!
+//! Pure functions only: no database and no HTTP types, so the rules can be
+//! tested without the server.
+
+use sha2::{Digest, Sha256};
+
+pub const SCOPE_GENERATE: &str = "generate";
+pub const SCOPE_LIBRARY_READ: &str = "library:read";
+pub const SCOPE_LIBRARY_WRITE: &str = "library:write";
+
+pub const ACCESS_TOKEN_PREFIX: &str = "artcraft_oauth_at_";
+pub const REFRESH_TOKEN_PREFIX: &str = "artcraft_oauth_rt_";
+pub const AUTH_CODE_PREFIX: &str = "artcraft_oauth_cd_";
+pub const CLIENT_ID_PREFIX: &str = "artcraft_oauth_cl_";
+
+pub const ACCESS_TOKEN_TTL_SECONDS: u64 = 60 * 60;
+pub const REFRESH_TOKEN_TTL_SECONDS: u64 = 30 * 24 * 60 * 60;
+pub const AUTH_CODE_TTL_SECONDS: u64 = 60;
+
+const KNOWN_SCOPES: &[&str] = &[SCOPE_GENERATE, SCOPE_LIBRARY_READ, SCOPE_LIBRARY_WRITE];
+const CROCKFORD: &[u8] = b"0123456789abcdefghjkmnpqrstvwxyz";
+
+/// Space-separated scopes, known names only, duplicates removed, stable order.
+pub fn normalize_scopes(raw: &str) -> Result<String, &'static str> {
+  let mut chosen: Vec<&str> = Vec::new();
+  for part in raw.split_whitespace() {
+    if !KNOWN_SCOPES.contains(&part) {
+      return Err("unknown scope");
+    }
+    if !chosen.contains(&part) {
+      chosen.push(part);
+    }
+  }
+  if chosen.is_empty() {
+    return Err("scope required");
+  }
+  // Keep the public order: generate, library:read, library:write.
+  let mut ordered = Vec::new();
+  for known in KNOWN_SCOPES {
+    if chosen.contains(known) {
+      ordered.push(*known);
+    }
+  }
+  Ok(ordered.join(" "))
+}
+
+pub fn scope_granted(granted: &str, required: &str) -> bool {
+  granted.split_whitespace().any(|scope| scope == required)
+}
+
+/// Requested scopes must be a subset of the scopes the client registered.
+pub fn scopes_within(requested: &str, allowed: &str) -> bool {
+  requested.split_whitespace().all(|scope| scope_granted(allowed, scope))
+}
+
+pub fn pkce_s256_challenge(verifier: &str) -> String {
+  let digest = Sha256::digest(verifier.as_bytes());
+  base64url_nopad(digest.as_ref())
+}
+
+pub fn pkce_verifier_ok(verifier: &str) -> bool {
+  let len = verifier.len();
+  (43..=128).contains(&len)
+    && verifier.bytes().all(|byte| {
+      byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.' | b'_' | b'~')
+    })
+}
+
+pub fn code_challenge_ok(challenge: &str) -> bool {
+  let len = challenge.len();
+  (43..=128).contains(&len)
+    && challenge.bytes().all(|byte| {
+      byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_')
+    })
+}
+
+pub fn sha256_hex(value: &str) -> String {
+  let digest = Sha256::digest(value.as_bytes());
+  let bytes: &[u8] = digest.as_ref();
+  let mut hex = String::with_capacity(bytes.len() * 2);
+  for byte in bytes {
+    hex.push_str(&format!("{byte:02x}"));
+  }
+  hex
+}
+
+/// The bearer credential, when it is an ArtCraft OAuth access token.
+pub fn access_token_from_authorization(header_value: &str) -> Option<&str> {
+  let value = header_value.trim();
+  let token = if let Some(rest) = strip_prefix_ignore_ascii_case(value, "Bearer ") {
+    rest.trim()
+  } else {
+    value
+  };
+  if token.starts_with(ACCESS_TOKEN_PREFIX) {
+    Some(token)
+  } else {
+    None
+  }
+}
+
+fn strip_prefix_ignore_ascii_case<'a>(value: &'a str, prefix: &str) -> Option<&'a str> {
+  if value.len() >= prefix.len() && value[..prefix.len()].eq_ignore_ascii_case(prefix) {
+    Some(&value[prefix.len()..])
+  } else {
+    None
+  }
+}
+
+pub fn secrets_match(presented: &str, stored_hash: &str) -> bool {
+  // Compare the hashes, not the raw secrets. Lengths are fixed, so this is a
+  // straight equality of the hex digest.
+  sha256_hex(presented) == stored_hash
+}
+
+/// `https` URIs, plus loopback `http` for local connector development.
+pub fn redirect_uri_allowed(uri: &str) -> bool {
+  if uri.len() > 512 || uri.chars().any(|c| c.is_control() || c.is_whitespace()) {
+    return false;
+  }
+  let Some((scheme, rest)) = uri.split_once("://") else {
+    return false;
+  };
+  if rest.is_empty() {
+    return false;
+  }
+  // Fragments are not allowed on redirect URIs.
+  if uri.contains('#') {
+    return false;
+  }
+  let Some(host) = redirect_host(rest) else {
+    return false;
+  };
+  match scheme {
+    "https" => true,
+    "http" => host == "localhost" || host == "127.0.0.1" || host == "::1",
+    _ => false,
+  }
+}
+
+/// Host from the part after `scheme://`. Bracketed IPv6 is kept whole.
+fn redirect_host(rest: &str) -> Option<&str> {
+  if let Some(v6) = rest.strip_prefix('[') {
+    let end = v6.find(']')?;
+    let host = &v6[..end];
+    if host.is_empty() {
+      return None;
+    }
+    return Some(host);
+  }
+  let host = rest.split(['/', '?', ':']).next().unwrap_or("");
+  if host.is_empty() {
+    None
+  } else {
+    Some(host)
+  }
+}
+
+pub fn redirect_matches(registered_newlines: &str, presented: &str) -> bool {
+  registered_newlines.split('\n').any(|uri| uri == presented)
+}
+
+pub fn html_escape(value: &str) -> String {
+  let mut out = String::with_capacity(value.len());
+  for ch in value.chars() {
+    match ch {
+      '&' => out.push_str("&amp;"),
+      '<' => out.push_str("&lt;"),
+      '>' => out.push_str("&gt;"),
+      '"' => out.push_str("&quot;"),
+      '\'' => out.push_str("&#39;"),
+      _ => out.push(ch),
+    }
+  }
+  out
+}
+
+pub fn random_token(prefix: &str, entropy_len: usize) -> String {
+  use rand::Rng;
+  let mut rng = rand::thread_rng();
+  let mut entropy = String::with_capacity(entropy_len);
+  for _ in 0..entropy_len {
+    let idx = rng.gen_range(0..CROCKFORD.len());
+    entropy.push(CROCKFORD[idx] as char);
+  }
+  format!("{prefix}{entropy}")
+}
+
+/// Decode a standard (not URL) base64 string. Padding is optional.
+pub fn base64_decode(input: &str) -> Option<Vec<u8>> {
+  fn val(byte: u8) -> Option<u8> {
+    match byte {
+      b'A'..=b'Z' => Some(byte - b'A'),
+      b'a'..=b'z' => Some(byte - b'a' + 26),
+      b'0'..=b'9' => Some(byte - b'0' + 52),
+      b'+' => Some(62),
+      b'/' => Some(63),
+      _ => None,
+    }
+  }
+  let bytes: Vec<u8> = input.bytes().filter(|b| !b.is_ascii_whitespace() && *b != b'=').collect();
+  if bytes.len() % 4 == 1 {
+    return None;
+  }
+  let mut out = Vec::new();
+  let mut i = 0;
+  while i < bytes.len() {
+    let b0 = val(*bytes.get(i)?)?;
+    let b1 = val(*bytes.get(i + 1)?)?;
+    out.push((b0 << 2) | (b1 >> 4));
+    if i + 2 < bytes.len() {
+      let b2 = val(bytes[i + 2])?;
+      out.push((b1 << 4) | (b2 >> 2));
+      if i + 3 < bytes.len() {
+        let b3 = val(bytes[i + 3])?;
+        out.push((b2 << 6) | b3);
+      }
+    }
+    i += 4;
+  }
+  Some(out)
+}
+
+/// `Authorization: Basic base64(client_id:client_secret)`.
+pub fn parse_basic_client(header_value: &str) -> Option<(String, String)> {
+  let rest = header_value.trim().strip_prefix("Basic ").or_else(|| header_value.trim().strip_prefix("basic "))?;
+  let decoded = base64_decode(rest.trim())?;
+  let text = String::from_utf8(decoded).ok()?;
+  let (id, secret) = text.split_once(':')?;
+  if id.is_empty() || secret.is_empty() {
+    return None;
+  }
+  Some((id.to_string(), secret.to_string()))
+}
+
+pub fn origin_matches_host(origin: &str, expected_host: &str) -> bool {
+  let without_scheme = origin.split_once("://").map(|(_, rest)| rest).unwrap_or(origin);
+  let host_port = without_scheme.split('/').next().unwrap_or("");
+  host_port.eq_ignore_ascii_case(expected_host)
+}
+
+fn base64url_nopad(data: &[u8]) -> String {
+  const TABLE: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+  let mut out = String::new();
+  let mut i = 0;
+  while i + 3 <= data.len() {
+    let n = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8) | (data[i + 2] as u32);
+    out.push(TABLE[((n >> 18) & 63) as usize] as char);
+    out.push(TABLE[((n >> 12) & 63) as usize] as char);
+    out.push(TABLE[((n >> 6) & 63) as usize] as char);
+    out.push(TABLE[(n & 63) as usize] as char);
+    i += 3;
+  }
+  if i < data.len() {
+    let remain = data.len() - i;
+    let b0 = data[i] as u32;
+    let b1 = if remain == 2 { data[i + 1] as u32 } else { 0 };
+    let n = (b0 << 16) | (b1 << 8);
+    out.push(TABLE[((n >> 18) & 63) as usize] as char);
+    out.push(TABLE[((n >> 12) & 63) as usize] as char);
+    if remain == 2 {
+      out.push(TABLE[((n >> 6) & 63) as usize] as char);
+    }
+  }
+  out
+}
