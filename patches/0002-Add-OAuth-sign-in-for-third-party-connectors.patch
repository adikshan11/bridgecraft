+pub async fn oauth_grants_page(request: HttpRequest, server_state: Data<Arc<ServerState>>) -> HttpResponse {
+  let mut connection = match server_state.mysql_pool.acquire().await {
+    Ok(connection) => connection,
+    Err(err) => {
+      warn!("OAuth grants pool error: {:?}", err);
+      return oauth_error(500, "server_error", "could not list apps");
+    }
+  };
+  let user = match require_user_session(&request, &server_state.session_checker, &mut *connection).await {
+    Ok(user) => user,
+    Err(CommonWebError::NotAuthorized) => {
+      return html_page("Sign in to ArtCraft", "<p>Sign in to ArtCraft in this browser to see connected apps.</p>");
+    }
+    Err(err) => {
+      warn!("OAuth grants session error: {:?}", err);
+      return oauth_error(500, "server_error", "could not list apps");
+    }
+  };
+  let grants = match list_oauth_grants_for_user(user.get_user_token().as_str(), &mut *connection).await {
+    Ok(grants) => grants,
+    Err(err) => {
+      warn!("OAuth grants query error: {:?}", err);
+      return oauth_error(500, "server_error", "could not list apps");
