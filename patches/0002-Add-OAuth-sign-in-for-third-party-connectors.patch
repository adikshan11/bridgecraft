+pub struct InsertOauthAuthorizationCodeArgs<'a> {
+  pub code_hash: &'a str,
+  pub client_token: &'a str,
+  pub user_token: &'a str,
+  pub redirect_uri: &'a str,
+  pub scopes: &'a str,
+  pub code_challenge: &'a str,
+  pub code_challenge_method: &'a str,
+  pub ttl_seconds: i64,
+}
+
+pub async fn insert_oauth_authorization_code<'c, E>(
+  args: InsertOauthAuthorizationCodeArgs<'_>,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+INSERT INTO oauth_authorization_codes
+SET
+  code_hash = ?,
+  client_token = ?,
+  user_token = ?,
+  redirect_uri = ?,
+  scopes = ?,
+  code_challenge = ?,
+  code_challenge_method = ?,
+  expires_at = DATE_ADD(NOW(), INTERVAL ? SECOND)
+    "#,
+  )
+  .bind(args.code_hash)
+  .bind(args.client_token)
+  .bind(args.user_token)
+  .bind(args.redirect_uri)
+  .bind(args.scopes)
+  .bind(args.code_challenge)
+  .bind(args.code_challenge_method)
+  .bind(args.ttl_seconds)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
+
+pub struct OauthAuthorizationCodeRecord {
+  pub client_token: String,
+  pub user_token: String,
+  pub redirect_uri: String,
+  pub scopes: String,
+  pub code_challenge: String,
+  pub code_challenge_method: String,
+}
+
+/// Lock one unused, unexpired authorization code. Must run inside a transaction.
+pub async fn lock_oauth_authorization_code<'c, E>(
+  code_hash: &str,
+  mysql_executor: E,
+) -> Result<Option<OauthAuthorizationCodeRecord>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let row = sqlx::query(
+    r#"
+SELECT
+  client_token,
+  user_token,
+  redirect_uri,
+  scopes,
+  code_challenge,
+  code_challenge_method
+FROM oauth_authorization_codes
+WHERE code_hash = ?
+  AND maybe_used_at IS NULL
+  AND expires_at > NOW()
+LIMIT 1
+FOR UPDATE
+    "#,
+  )
+  .bind(code_hash)
+  .fetch_optional(mysql_executor)
+  .await?;
+  match row {
+    None => Ok(None),
+    Some(row) => Ok(Some(OauthAuthorizationCodeRecord {
+      client_token: row.try_get("client_token")?,
+      user_token: row.try_get("user_token")?,
+      redirect_uri: row.try_get("redirect_uri")?,
+      scopes: row.try_get("scopes")?,
+      code_challenge: row.try_get("code_challenge")?,
+      code_challenge_method: row.try_get("code_challenge_method")?,
+    })),
+  }
+}
+
+pub async fn mark_oauth_authorization_code_used<'c, E>(
+  code_hash: &str,
+  mysql_executor: E,
+) -> Result<bool, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let result = sqlx::query(
+    r#"
+UPDATE oauth_authorization_codes
+SET maybe_used_at = NOW()
+WHERE code_hash = ?
+  AND maybe_used_at IS NULL
+    "#,
+  )
+  .bind(code_hash)
+  .execute(mysql_executor)
+  .await?;
+  Ok(result.rows_affected() == 1)
+}
+
+pub struct InsertOauthAccessTokenArgs<'a> {
+  pub access_token_hash: &'a str,
+  pub refresh_token_hash: &'a str,
+  pub client_token: &'a str,
+  pub user_token: &'a str,
+  pub scopes: &'a str,
+  pub access_ttl_seconds: i64,
+  pub refresh_ttl_seconds: i64,
+}
+
+pub async fn insert_oauth_access_token<'c, E>(
+  args: InsertOauthAccessTokenArgs<'_>,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+INSERT INTO oauth_access_tokens
+SET
+  access_token_hash = ?,
+  refresh_token_hash = ?,
+  client_token = ?,
+  user_token = ?,
+  scopes = ?,
+  expires_at = DATE_ADD(NOW(), INTERVAL ? SECOND),
+  refresh_expires_at = DATE_ADD(NOW(), INTERVAL ? SECOND)
+    "#,
+  )
+  .bind(args.access_token_hash)
+  .bind(args.refresh_token_hash)
+  .bind(args.client_token)
+  .bind(args.user_token)
+  .bind(args.scopes)
+  .bind(args.access_ttl_seconds)
+  .bind(args.refresh_ttl_seconds)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
+
+pub struct OauthAccessSession {
+  pub record: ApiOrWebSessionUserRecord,
+  pub scopes: String,
+  pub client_token: String,
+}
+
+fn access_row_to_session(row: &sqlx::mysql::MySqlRow) -> Result<OauthAccessSession, sqlx::Error> {
+  let user_token: String = row.try_get("user_token")?;
+  Ok(OauthAccessSession {
+    record: ApiOrWebSessionUserRecord {
+      user_token: UserToken::new_from_str(&user_token),
+      username: row.try_get("username")?,
+      display_name: row.try_get("display_name")?,
+      email_address: row.try_get("email_address")?,
+      user_role_slug: row.try_get("user_role_slug")?,
+      is_banned: i8_to_bool(row.try_get("is_banned")?),
+      can_ban_users: nullable_i8_to_bool_default_false(row.try_get("can_ban_users")?),
+      maybe_feature_flags: row.try_get("maybe_feature_flags")?,
+      maybe_api_key_token: None,
+      maybe_mcp_session_token: None,
+    },
+    scopes: row.try_get("scopes")?,
+    client_token: row.try_get("client_token")?,
+  })
+}
+
+const ACCESS_COLUMNS: &str = "
+  users.token AS user_token,
+  users.username,
+  users.display_name,
+  users.email_address,
+  users.user_role_slug,
+  users.is_banned,
+  user_roles.can_ban_users,
+  users.maybe_feature_flags,
+  oauth_access_tokens.scopes,
+  oauth_access_tokens.client_token";
+
+const ACCESS_FROM: &str = "
+FROM oauth_access_tokens
+INNER JOIN users
+  ON users.token = oauth_access_tokens.user_token
+LEFT OUTER JOIN user_roles
+  ON users.user_role_slug = user_roles.slug";
+
+pub async fn get_oauth_access_session_by_hash<'c, E>(
+  access_token_hash: &str,
+  mysql_executor: E,
+) -> Result<Option<OauthAccessSession>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let sql = format!(
+    "SELECT {ACCESS_COLUMNS}
+{ACCESS_FROM}
+WHERE oauth_access_tokens.access_token_hash = ?
+  AND oauth_access_tokens.maybe_revoked_at IS NULL
+  AND oauth_access_tokens.expires_at > NOW()
+  AND users.user_deleted_at IS NULL
+  AND users.mod_deleted_at IS NULL
+LIMIT 1"
+  );
+  let row = sqlx::query(&sql)
+    .bind(access_token_hash)
+    .fetch_optional(mysql_executor)
+    .await?;
+  match row {
+    None => Ok(None),
+    Some(row) => Ok(Some(access_row_to_session(&row)?)),
+  }
+}
+
+pub struct OauthRefreshSession {
+  pub session: OauthAccessSession,
+  pub refresh_token_hash: String,
+}
+
+pub async fn lock_oauth_refresh_session<'c, E>(
+  refresh_token_hash: &str,
+  mysql_executor: E,
+) -> Result<Option<OauthRefreshSession>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let sql = format!(
+    "SELECT {ACCESS_COLUMNS},
+  oauth_access_tokens.refresh_token_hash
+{ACCESS_FROM}
+WHERE oauth_access_tokens.refresh_token_hash = ?
+  AND oauth_access_tokens.maybe_revoked_at IS NULL
+  AND oauth_access_tokens.refresh_expires_at > NOW()
+  AND users.user_deleted_at IS NULL
+  AND users.mod_deleted_at IS NULL
+LIMIT 1
+FOR UPDATE"
+  );
+  let row = sqlx::query(&sql)
+    .bind(refresh_token_hash)
+    .fetch_optional(mysql_executor)
+    .await?;
+  match row {
+    None => Ok(None),
+    Some(row) => Ok(Some(OauthRefreshSession {
+      refresh_token_hash: row.try_get("refresh_token_hash")?,
+      session: access_row_to_session(&row)?,
+    })),
+  }
+}
+
+pub async fn revoke_oauth_refresh_hash<'c, E>(
+  refresh_token_hash: &str,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+UPDATE oauth_access_tokens
+SET maybe_revoked_at = NOW()
+WHERE refresh_token_hash = ?
+  AND maybe_revoked_at IS NULL
+    "#,
+  )
+  .bind(refresh_token_hash)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
+
+/// Revoke by either secret hash. Unknown tokens are a no-op.
+pub async fn revoke_oauth_token_hash<'c, E>(
+  token_hash: &str,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+UPDATE oauth_access_tokens
+SET maybe_revoked_at = NOW()
+WHERE maybe_revoked_at IS NULL
+  AND (access_token_hash = ? OR refresh_token_hash = ?)
+    "#,
+  )
+  .bind(token_hash)
+  .bind(token_hash)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
+
+pub struct OauthGrantRecord {
+  pub client_token: String,
+  pub client_name: String,
+  pub scopes: String,
+}
+
+pub async fn list_oauth_grants_for_user<'c, E>(
+  user_token: &str,
+  mysql_executor: E,
+) -> Result<Vec<OauthGrantRecord>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let rows = sqlx::query(
+    r#"
+SELECT
+  oauth_clients.token AS client_token,
+  oauth_clients.client_name,
+  oauth_access_tokens.scopes
+FROM oauth_access_tokens
+INNER JOIN oauth_clients
+  ON oauth_clients.token = oauth_access_tokens.client_token
+WHERE oauth_access_tokens.user_token = ?
+  AND oauth_access_tokens.maybe_revoked_at IS NULL
+  AND oauth_access_tokens.refresh_expires_at > NOW()
+ORDER BY oauth_access_tokens.id DESC
+    "#,
+  )
+  .bind(user_token)
+  .fetch_all(mysql_executor)
+  .await?;
+
+  let mut grants = Vec::new();
+  for row in rows {
+    let client_token: String = row.try_get("client_token")?;
+    if grants.iter().any(|grant: &OauthGrantRecord| grant.client_token == client_token) {
+      continue;
+    }
+    grants.push(OauthGrantRecord {
+      client_token,
+      client_name: row.try_get("client_name")?,
+      scopes: row.try_get("scopes")?,
+    });
+  }
+  Ok(grants)
+}
+
+pub async fn revoke_oauth_grants_for_client<'c, E>(
+  user_token: &str,
+  client_token: &str,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+UPDATE oauth_access_tokens
+SET maybe_revoked_at = NOW()
+WHERE user_token = ?
+  AND client_token = ?
+  AND maybe_revoked_at IS NULL
+    "#,
+  )
+  .bind(user_token)
+  .bind(client_token)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
