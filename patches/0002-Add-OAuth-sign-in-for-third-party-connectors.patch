+use sqlx::{Executor, MySql, Row};
+
+use tokens::tokens::users::UserToken;
+
+use crate::helpers::boolean_converters::{i8_to_bool, nullable_i8_to_bool_default_false};
+use crate::queries::users::api_or_web_sessions::api_or_web_session_user_record::ApiOrWebSessionUserRecord;
+
+pub struct InsertOauthClientArgs<'a> {
+  pub token: &'a str,
+  pub client_secret_hash: Option<&'a str>,
+  pub client_name: &'a str,
+  pub redirect_uris: &'a str,
+  pub token_endpoint_auth_method: &'a str,
+  pub allowed_scopes: &'a str,
+}
+
+pub struct OauthClientRecord {
+  pub token: String,
+  pub client_secret_hash: Option<String>,
+  pub client_name: String,
+  pub redirect_uris: String,
+  pub token_endpoint_auth_method: String,
+  pub allowed_scopes: String,
+}
+
+fn client_from_row(row: sqlx::mysql::MySqlRow) -> Result<OauthClientRecord, sqlx::Error> {
+  Ok(OauthClientRecord {
+    token: row.try_get("token")?,
+    client_secret_hash: row.try_get("client_secret_hash")?,
+    client_name: row.try_get("client_name")?,
+    redirect_uris: row.try_get("redirect_uris")?,
+    token_endpoint_auth_method: row.try_get("token_endpoint_auth_method")?,
+    allowed_scopes: row.try_get("allowed_scopes")?,
+  })
+}
+
+pub async fn insert_oauth_client<'c, E>(
+  args: InsertOauthClientArgs<'_>,
+  mysql_executor: E,
+) -> Result<(), sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  sqlx::query(
+    r#"
+INSERT INTO oauth_clients
+SET
+  token = ?,
+  client_secret_hash = ?,
+  client_name = ?,
+  redirect_uris = ?,
+  token_endpoint_auth_method = ?,
+  allowed_scopes = ?
+    "#,
+  )
+  .bind(args.token)
+  .bind(args.client_secret_hash)
+  .bind(args.client_name)
+  .bind(args.redirect_uris)
+  .bind(args.token_endpoint_auth_method)
+  .bind(args.allowed_scopes)
+  .execute(mysql_executor)
+  .await?;
+  Ok(())
+}
+
+pub async fn get_oauth_client_by_token<'c, E>(
+  token: &str,
+  mysql_executor: E,
+) -> Result<Option<OauthClientRecord>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let row = sqlx::query(
+    r#"
+SELECT
+  token,
+  client_secret_hash,
+  client_name,
+  redirect_uris,
+  token_endpoint_auth_method,
+  allowed_scopes
+FROM oauth_clients
+WHERE token = ?
+  AND maybe_revoked_at IS NULL
+LIMIT 1
+    "#,
+  )
+  .bind(token)
+  .fetch_optional(mysql_executor)
+  .await?;
+  match row {
+    None => Ok(None),
+    Some(row) => Ok(Some(client_from_row(row)?)),
+  }
+}
