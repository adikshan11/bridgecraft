       if let Err(err) = tx.commit().await {
         warn!("OAuth code commit error: {:?}", err);
@@ -570,7 +571,7 @@ async fn refresh_grant(
   }
   let scopes = locked.session.scopes.clone();
   let user_token = locked.session.record.user_token.as_str().to_string();
-  match mint_token_pair(&user_token, &client.token, &scopes, &mut tx).await {
+  match mint_token_pair(&user_token, &client.token, &scopes, &mut *tx).await {
     Ok(response) => {
       if let Err(err) = tx.commit().await {
         warn!("OAuth refresh commit error: {:?}", err);
