-/// Revoke by either secret hash. Unknown tokens are a no-op.
+/// A refresh token that was revoked (for example by rotation) and has not yet
+/// expired. Returns the user token and client token that owned it.
+pub async fn find_revoked_oauth_refresh_grant<'c, E>(
+  refresh_token_hash: &str,
+  mysql_executor: E,
+) -> Result<Option<(String, String)>, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let row = sqlx::query(
+    r#"
+SELECT user_token, client_token
+FROM oauth_access_tokens
+WHERE refresh_token_hash = ?
+  AND maybe_revoked_at IS NOT NULL
+  AND refresh_expires_at > NOW()
+LIMIT 1
+    "#,
+  )
+  .bind(refresh_token_hash)
+  .fetch_optional(mysql_executor)
+  .await?;
+  match row {
+    None => Ok(None),
+    Some(row) => Ok(Some((row.try_get("user_token")?, row.try_get("client_token")?))),
+  }
+}
