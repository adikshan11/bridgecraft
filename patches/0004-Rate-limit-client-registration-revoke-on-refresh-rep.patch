+/// Clients registered in the last `minutes`, optionally from one IP address.
+pub async fn count_oauth_clients_since<'c, E>(
+  maybe_ip_address: Option<&str>,
+  minutes: i64,
+  mysql_executor: E,
+) -> Result<i64, sqlx::Error>
+where
+  E: Executor<'c, Database = MySql>,
+{
+  let row = match maybe_ip_address {
+    Some(ip_address) => {
+      sqlx::query(
+        r#"
+SELECT COUNT(*) AS total
+FROM oauth_clients
+WHERE created_at > DATE_SUB(NOW(), INTERVAL ? MINUTE)
+  AND ip_address_creation = ?
+        "#,
+      )
+      .bind(minutes)
+      .bind(ip_address)
+      .fetch_one(mysql_executor)
+      .await?
+    }
+    None => {
+      sqlx::query(
+        r#"
+SELECT COUNT(*) AS total
+FROM oauth_clients
+WHERE created_at > DATE_SUB(NOW(), INTERVAL ? MINUTE)
+        "#,
+      )
+      .bind(minutes)
+      .fetch_one(mysql_executor)
+      .await?
+    }
+  };
+  row.try_get("total")
+}
