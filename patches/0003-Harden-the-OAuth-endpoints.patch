+
+/// Cookie-authenticated POSTs must carry an `Origin` that matches this host.
+/// A missing `Origin` is refused.
+fn same_site_post(request: &HttpRequest) -> bool {
+  let Some(origin) = request.headers().get(header::ORIGIN).and_then(|value| value.to_str().ok()) else {
+    return false;
+  };
+  let host = request.connection_info().host().to_string();
+  origin_matches_host(origin, &host)
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn percent_decode_does_not_panic_on_multibyte_text() {
+    assert_eq!(percent_decode("%a\u{20ac}"), "%a\u{20ac}");
+    assert_eq!(percent_decode("%e2%82%ac"), "\u{20ac}");
+    assert_eq!(percent_decode("a+b%20c%"), "a b c%");
+    assert_eq!(percent_decode("%zz"), "%zz");
+  }
+
+  #[test]
+  fn percent_encode_round_trips() {
+    let raw = "state with spaces&=/";
+    assert_eq!(percent_decode(&percent_encode(raw)), raw);
+  }
+
+  #[test]
+  fn same_site_post_needs_a_matching_origin() {
+    use actix_web::test::TestRequest;
+    let missing = TestRequest::default().insert_header((header::HOST, "api.storyteller.ai")).to_http_request();
+    assert!(!same_site_post(&missing));
+    let other = TestRequest::default()
+      .insert_header((header::HOST, "api.storyteller.ai"))
+      .insert_header((header::ORIGIN, "https://evil.example"))
+      .to_http_request();
+    assert!(!same_site_post(&other));
+    let same = TestRequest::default()
+      .insert_header((header::HOST, "api.storyteller.ai"))
+      .insert_header((header::ORIGIN, "https://api.storyteller.ai"))
+      .to_http_request();
+    assert!(same_site_post(&same));
+  }
+}
